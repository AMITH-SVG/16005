# Campus Notification System - Environment Variables Example
# Copy this file to .env.local and update with your values

# API Configuration
VITE_API_BASE_URL=http://4.224.186.213/evaluation-service

# Application Configuration
VITE_APP_NAME=Campus Notification System
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_LOGGING=true
VITE_LOG_LEVEL=debug

# Pagination Defaults
VITE_DEFAULT_PAGE=1
VITE_DEFAULT_LIMIT=10

# Priority Notification Defaults
VITE_DEFAULT_TOP_N=10
VITE_TOP_N_OPTIONS=5,10,15,20
